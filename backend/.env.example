# queryX backend configuration example.
# Copy to .env and adjust as needed.

# Path to the statistics/cost configuration file. Defaults to
# backend/app/compiler/config/statistics.yaml when unset.
SMART_SQL_STATS=

# Optional PostgreSQL connection used ONLY for benchmark validation. The custom
# optimizer never depends on it. Leave DATABASE_ENABLED=false to run the
# project without any database.
DATABASE_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=queryx
POSTGRES_USER=queryx
POSTGRES_PASSWORD=queryx
